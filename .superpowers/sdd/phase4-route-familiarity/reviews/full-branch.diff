+    }
+
+    goOffline() {
+        this.setState(DriverState.OFFLINE);
+        this.renderOfflineUI();
+    }
+
+    goOnline() {
+        this.setState(DriverState.AVAILABLE);
+        this.renderAvailableUI();
+    }
+
+    cancelTrip() {
+        this._navigationLocked = false;
+        this._selectedStationId = null;
+        this._hideRecommendationPanel();
