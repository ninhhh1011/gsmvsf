+
+        if (trajId) {
+            try {
+                await this.replay.loadTrajectory(trajId);
+            } catch (err) {
+                if (this.generation !== currentGen) return;
+                console.warn(`Dataset trajectory ${trajId} load failed, falling back to polyline simulation:`, err);
