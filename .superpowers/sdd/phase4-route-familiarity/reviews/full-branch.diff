+                    const stMatch = this.stations?.find(s => s.station_id === c.station_id);
+                    return {
+                        ...c,
+                        rank: c.rank ?? (idx + 1),
+                        station_id: c.station_id,
+                        latitude: c.latitude ?? stMatch?.latitude,
+                        longitude: c.longitude ?? stMatch?.longitude,
