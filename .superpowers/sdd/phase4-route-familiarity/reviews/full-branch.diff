+
+        const stationPos = { latitude: st.latitude, longitude: st.longitude };
+        const vCat = this.currentVehicle?.vehicle_type || 'EV_CAR';
+
+        this.bindings.setNavigationButtonState('Đang dẫn đường...', true);
