+                    await this.replay.loadFromPolyline(this.fullRouteCoords);
+                }
+            }
+        } else if (this.fullRouteCoords && this.fullRouteCoords.length > 1) {
+            await this.replay.loadFromPolyline(this.fullRouteCoords);
+        }
