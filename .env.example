APP_NAME=EV Recommendation API
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
DATASET_PATH=./dataset_v1
PRIMARY_PBF_PATH=./dataset_v1/map/raw/hanoi-patched.osm.pbf
GRAPHHOPPER_BASE_URL=http://127.0.0.1:8989
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ev_recommendation
DATABASE_URL_SYNC=postgresql://postgres:postgres@127.0.0.1:5432/ev_recommendation
REDIS_URL=redis://127.0.0.1:6379/0

# City & Geographic Bounding Box Configuration
CITY_NAME=Hanoi
MAP_DEFAULT_CENTER_LAT=21.0285
MAP_DEFAULT_CENTER_LNG=105.8542
MAP_DEFAULT_ZOOM=13
MAP_BBOX_MIN_LAT=20.5
MAP_BBOX_MAX_LAT=21.5
MAP_BBOX_MIN_LNG=105.3
MAP_BBOX_MAX_LNG=106.3

# Snapshot & Freshness Configuration
SNAPSHOT_INGESTION_TOKEN=
SNAPSHOT_CACHE_PREFIX=week4:snapshot:
SNAPSHOT_CACHE_TTL_S=60
SNAPSHOT_CACHE_TIMEOUT_S=0.2
SNAPSHOT_DB_TIMEOUT_S=5
STATION_FRESH_S=600
QUEUE_FRESH_S=600
TRAFFIC_FRESH_S=1800
MISSING_QUEUE_WAIT_S=5400

# Opt-in route familiarity (requires trusted gateway identity signing when enabled)
ENABLE_ROUTE_FAMILIARITY=false
ROUTE_FAMILIARITY_IDENTITY_SECRET=
ROUTE_FAMILIARITY_LOOKBACK_DAYS=7
MAX_FAMILIARITY_PENALTY_S=30
FAMILIARITY_MINIMUM_SUPPORT_ADHERENCE=0.10
FAMILIARITY_PRIOR_MEAN=0.5
FAMILIARITY_PRIOR_STRENGTH=3
FAMILIARITY_MINIMUM_COMMUNITY_DRIVERS=5
FAMILIARITY_CONFIDENCE_PRIOR_STRENGTH=3
