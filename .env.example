APP_NAME=EV Recommendation API
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
DATASET_PATH=./dataset_v1
PRIMARY_PBF_PATH=./dataset_v1/map/raw/hanoi-patched.osm.pbf
GRAPHHOPPER_BASE_URL=http://127.0.0.1:8989
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/ev_recommendation
DATABASE_URL_SYNC=postgresql://postgres:postgres@127.0.0.1:5432/ev_recommendation
REDIS_URL=redis://127.0.0.1:6379/0
# Configure a local secret before enabling internal snapshot ingestion.
SNAPSHOT_INGESTION_TOKEN=
SNAPSHOT_CACHE_TTL_S=60
SNAPSHOT_CACHE_TIMEOUT_S=0.2
SNAPSHOT_DB_TIMEOUT_S=5
STATION_FRESH_S=600
QUEUE_FRESH_S=600
TRAFFIC_FRESH_S=1800
MISSING_QUEUE_WAIT_S=5400
